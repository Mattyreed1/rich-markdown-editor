{
  "name": "rich-markdown-editor",
  "displayName": "Rich Markdown Editor",
  "description": "WYSIWYG Markdown Editor",
  "publisher": "mattyreed",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattyreed/rich-markdown-editor.git"
  },
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "richMarkdown.wysiwygEditor",
        "displayName": "Rich Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "glob": "^8.1.0",
    "mocha": "^11.7.5",
    "playwright": "^1.58.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "jsdom": "^28.1.0"
  }
}
